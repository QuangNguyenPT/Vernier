<UserControl x:Class="Vernier.App.Views.TutorPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Vernier.App.Views">
    <UserControl.Resources>
        <DataTemplate x:Key="CheckTemplate">
            <Grid Margin="0,3,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="52"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="Tag" Style="{StaticResource Readout}" Text="note" Foreground="{DynamicResource InkFaint}" Margin="0,2,0,0"/>
                <TextBlock Grid.Column="1" Style="{StaticResource Soft}" FontSize="12" Text="{Binding Detail}"/>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Passed">
                    <Setter TargetName="Tag" Property="Text" Value="pass"/>
                    <Setter TargetName="Tag" Property="Foreground" Value="{DynamicResource Ok}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Failed">
                    <Setter TargetName="Tag" Property="Text" Value="fail"/>
                    <Setter TargetName="Tag" Property="Foreground" Value="{DynamicResource Err}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Skipped">
                    <Setter TargetName="Tag" Property="Text" Value="skip"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- The rule on the left says who is speaking: yellow is you, blue is the tutor. -->
        <DataTemplate x:Key="TranscriptTemplate">
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Rectangle x:Name="Bar" Fill="{DynamicResource Accent}"/>
                <StackPanel Grid.Column="1" Margin="14,0,0,0">
                    <TextBlock Style="{StaticResource Readout}" Text="{Binding Meta}" Margin="0,0,0,4"/>
                    <local:RichAnswer x:Name="Body" Source="{Binding Text, Mode=OneWay}"/>
                    <ItemsControl ItemsSource="{Binding Notices}" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource Body}" FontSize="12" Foreground="{DynamicResource Warn}" Text="{Binding}" Margin="0,2,0,0"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding Checks}" ItemTemplate="{StaticResource CheckTemplate}" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsUser}" Value="True">
                    <Setter TargetName="Bar" Property="Fill" Value="{DynamicResource You}"/>
                    <Setter TargetName="Body" Property="Foreground" Value="{DynamicResource InkSoft}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border BorderBrush="{DynamicResource Rule}" BorderThickness="0,0,0,1">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource Quiet}" Content="New conversation" Click="OnNew"/>
                <StackPanel x:Name="Modes" Orientation="Horizontal">
                    <RadioButton Style="{StaticResource SegmentRadio}" Content="ASK" Tag="Ask" GroupName="tutor-mode" Checked="OnMode" ToolTip="A direct answer"/>
                    <RadioButton Style="{StaticResource SegmentRadio}" Content="TUTOR" Tag="Tutor" GroupName="tutor-mode" Checked="OnMode" ToolTip="Teach the concept; guide rather than solve"/>
                    <RadioButton Style="{StaticResource SegmentRadio}" Content="REVIEW" Tag="Review" GroupName="tutor-mode" Checked="OnMode" ToolTip="Turn this into revision material"/>
                    <RadioButton Style="{StaticResource SegmentRadio}" Content="ASSIST" Tag="Assist" GroupName="tutor-mode" Checked="OnMode" ToolTip="Help operating the application on screen"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <local:StageScale x:Name="Scale" Grid.Row="1" Height="30" Margin="0,10,0,0"/>

        <ScrollViewer x:Name="Scroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0" Focusable="False">
            <Grid>
                <ItemsControl x:Name="Items" ItemTemplate="{StaticResource TranscriptTemplate}" Margin="0,0,10,0"/>
                <StackPanel x:Name="Empty" VerticalAlignment="Center" Margin="0,0,24,0" MaxWidth="520" HorizontalAlignment="Left">
                    <TextBlock Style="{StaticResource Title}" Text="Stay in your work."/>
                    <TextBlock Style="{StaticResource Soft}" FontSize="14" Text="Vernier sits over your screen and waits. You have two tools, and both work from anywhere, with this window closed:"/>
                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="AskKey" Style="{StaticResource Mono}" Foreground="{DynamicResource You}"/>
                        <TextBlock Grid.Column="1" Style="{StaticResource Body}" Text="Ask. Vernier looks at your screen and answers: explain this, or what is wrong with my diagram." Margin="0,0,0,12"/>
                        <TextBlock x:Name="PenKey" Grid.Row="1" Style="{StaticResource Mono}" Foreground="{DynamicResource You}"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Body}" Text="Pen. Circle the thing you do not understand, in a video, a paper, anything. Vernier explains it and marks the screen in blue."/>
                    </Grid>
                    <TextBlock Style="{StaticResource Soft}" FontSize="12.5" Margin="0,18,0,0" Text="A light-blue wave runs round the screen edge whenever Vernier is looking. Closing this window keeps Vernier in the notification area. Questions typed below are not about the screen."/>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Proposed input steps (Assist mode) -->
        <Border x:Name="ActionsBar" Grid.Row="3" Visibility="Collapsed" Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Accent}" BorderThickness="3,0,0,0" Padding="12,8" Margin="0,8,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Review steps…" Click="OnRunActions" Margin="8,0,0,0"/>
                    <Button Style="{StaticResource Quiet}" Content="Discard" Click="OnDiscardActions"/>
                </StackPanel>
                <TextBlock x:Name="ActionsText" Style="{StaticResource Body}" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="4" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="Input" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="54" MaxHeight="140" VerticalScrollBarVisibility="Auto"
                     PreviewKeyDown="OnInputKey" AutomationProperties.Name="Question for the tutor"/>
            <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Bottom">
                <Button x:Name="Talk" Content="Hold to talk" PreviewMouseLeftButtonDown="OnTalkDown" PreviewMouseLeftButtonUp="OnTalkUp" PreviewKeyDown="OnTalkKeyDown" PreviewKeyUp="OnTalkKeyUp"
                        Margin="0,0,0,6" AutomationProperties.Name="Push to talk"/>
                <Button x:Name="Send" Style="{StaticResource Primary}" Content="Ask" Click="OnSend" MinWidth="104" AutomationProperties.Name="Ask the tutor"/>
            </StackPanel>
        </Grid>

        <DockPanel Grid.Row="5" Margin="0,8,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <ToggleButton x:Name="SpeakToggle" Style="{StaticResource Segment}" Content="SPEAK ANSWERS" Click="OnSpeakToggle" ToolTip="Read answers aloud (local Windows voice)"/>
                <Button x:Name="SpeechPause" Style="{StaticResource Quiet}" Content="Pause voice" Click="OnSpeechPause"/>
                <Button x:Name="SpeechStop" Style="{StaticResource Quiet}" Content="Stop voice" Click="OnSpeechStop"/>
            </StackPanel>
            <TextBlock x:Name="StatusText" Style="{StaticResource Readout}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
        </DockPanel>
    </Grid>
</UserControl>
