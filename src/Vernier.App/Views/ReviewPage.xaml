<UserControl x:Class="Vernier.App.Views.ReviewPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Style="{StaticResource Title}" Text="Review"/>
            <TextBlock x:Name="Summary" Style="{StaticResource Soft}"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" MinWidth="260"/>
                <ColumnDefinition Width="28"/>
                <ColumnDefinition Width="6*"/>
            </Grid.ColumnDefinitions>

            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Readout}" Text="study queue · most urgent first" Margin="0,0,0,6"/>
                <ListBox x:Name="Queue" SelectionChanged="OnSelect" AutomationProperties.Name="Study queue">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="92"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="Kind" Style="{StaticResource Readout}" Text="{Binding Kind}" Margin="0,2,0,0"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Style="{StaticResource Body}" Text="{Binding Title}" TextTrimming="CharacterEllipsis" MaxHeight="38"/>
                                    <TextBlock Style="{StaticResource Soft}" FontSize="11.5" Text="{Binding Reason}" TextTrimming="CharacterEllipsis" MaxHeight="32"/>
                                </StackPanel>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Kind}" Value="misconception">
                                    <Setter TargetName="Kind" Property="Foreground" Value="{DynamicResource Err}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="card">
                                    <Setter TargetName="Kind" Property="Foreground" Value="{DynamicResource AccentText}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <Border Grid.Column="2" Style="{StaticResource Panel}" Padding="24">
                <Grid>
                    <StackPanel x:Name="Nothing" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="340">
                        <TextBlock Style="{StaticResource Heading}" Text="Nothing selected" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="NothingText" Style="{StaticResource Soft}" TextAlignment="Center"/>
                    </StackPanel>

                    <DockPanel x:Name="CardView" Visibility="Collapsed">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <Button DockPanel.Dock="Right" Style="{StaticResource Quiet}" Content="Delete card" Click="OnDeleteCard" AutomationProperties.Name="Delete this card" ToolTip="Remove this card and its review history"/>
                            <TextBlock x:Name="CardMeta" Style="{StaticResource Readout}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <StackPanel DockPanel.Dock="Bottom" x:Name="Grades" Margin="0,16,0,0">
                            <TextBlock Style="{StaticResource Readout}" Text="how well did you recall it? · keys 1–4" Margin="0,0,0,6"/>
                            <UniformGrid Rows="1">
                                <Button Content="Again" Tag="1" Click="OnGrade" Margin="0,0,6,0" ToolTip="Did not recall. Shown again tomorrow."/>
                                <Button Content="Hard" Tag="3" Click="OnGrade" Margin="0,0,6,0" ToolTip="Recalled with real effort."/>
                                <Button Content="Good" Tag="4" Click="OnGrade" Margin="0,0,6,0" ToolTip="Recalled after a moment."/>
                                <Button Content="Easy" Tag="5" Click="OnGrade" ToolTip="Recalled instantly."/>
                            </UniformGrid>
                        </StackPanel>
                        <Button DockPanel.Dock="Bottom" x:Name="Reveal" Style="{StaticResource Primary}" Content="Show answer  (Space)" Click="OnReveal" HorizontalAlignment="Left" Margin="0,16,0,0"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                            <StackPanel>
                                <TextBox x:Name="Front" Style="{StaticResource ReadingBox}" FontSize="19"/>
                                <Border x:Name="BackHost" Style="{StaticResource Section}" Visibility="Collapsed">
                                    <TextBox x:Name="Back" Style="{StaticResource ReadingBox}"/>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>

                    <DockPanel x:Name="TopicView" Visibility="Collapsed">
                        <TextBlock DockPanel.Dock="Top" x:Name="TopicMeta" Style="{StaticResource Readout}" Margin="0,0,0,10"/>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Style="{StaticResource Primary}" Content="Work on this with the tutor" Click="OnAskTutor"/>
                            <Button x:Name="ResolveButton" Content="Mark as resolved" Click="OnResolve" Margin="8,0,0,0"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBox x:Name="TopicTitle" Style="{StaticResource ReadingBox}" FontSize="19"/>
                            <TextBox x:Name="TopicReason" Style="{StaticResource ReadingBox}" Margin="0,10,0,0" Foreground="{DynamicResource InkSoft}"/>
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
