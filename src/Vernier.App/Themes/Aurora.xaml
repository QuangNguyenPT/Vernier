<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- Aurora: deep sea-green night with a teal tutor; cool and quiet. Blue-family accent is the tutor, yellow is you. Contrast checked (text pairs >= 4.5:1). -->
    <sys:Boolean x:Key="IsDark">True</sys:Boolean>
    <SolidColorBrush x:Key="Bg" Color="#08171A"/>
    <SolidColorBrush x:Key="Surface" Color="#0D2226"/>
    <SolidColorBrush x:Key="SurfaceAlt" Color="#122C31"/>
    <SolidColorBrush x:Key="Ink" Color="#E2F1F0"/>
    <SolidColorBrush x:Key="InkSoft" Color="#A9C7C5"/>
    <SolidColorBrush x:Key="InkFaint" Color="#7FA19F"/>
    <SolidColorBrush x:Key="Rule" Color="#1C3A3F"/>
    <SolidColorBrush x:Key="RuleStrong" Color="#3D6266"/>
    <SolidColorBrush x:Key="Accent" Color="#4FD1C5"/>
    <SolidColorBrush x:Key="AccentText" Color="#7FE0D6"/>
    <SolidColorBrush x:Key="You" Color="#FFD84D"/>
    <SolidColorBrush x:Key="OnInk" Color="#08171A"/>
    <SolidColorBrush x:Key="Ok" Color="#6FD98A"/>
    <SolidColorBrush x:Key="Warn" Color="#F2C14E"/>
    <SolidColorBrush x:Key="Err" Color="#FF8A8A"/>
    <SolidColorBrush x:Key="Hover" Color="#16323A"/>
    <SolidColorBrush x:Key="Pressed" Color="#1F3F45"/>
    <!-- Depth: light comes from above. Glass tints the acrylic backdrop; Edge lights the top of a raised surface; Sheen lifts a filled button. -->
    <SolidColorBrush x:Key="BgGlass" Color="#D808171A"/>
    <Color x:Key="ShadowColor">#000000</Color>
    <LinearGradientBrush x:Key="Edge" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#3D6266"/>
        <GradientStop Offset="1" Color="#1C3A3F"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Sheen" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#1FFFFFFF"/>
        <GradientStop Offset="0.55" Color="#00FFFFFF"/>
    </LinearGradientBrush>
</ResourceDictionary>
