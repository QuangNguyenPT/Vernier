<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- Nebula: ink-violet night with a periwinkle tutor. Blue-family accent is the tutor, yellow is you. Contrast checked (text pairs >= 4.5:1). -->
    <sys:Boolean x:Key="IsDark">True</sys:Boolean>
    <SolidColorBrush x:Key="Bg" Color="#0E0C1A"/>
    <SolidColorBrush x:Key="Surface" Color="#151228"/>
    <SolidColorBrush x:Key="SurfaceAlt" Color="#1C1834"/>
    <SolidColorBrush x:Key="Ink" Color="#ECE9FA"/>
    <SolidColorBrush x:Key="InkSoft" Color="#BDB6DE"/>
    <SolidColorBrush x:Key="InkFaint" Color="#9089B5"/>
    <SolidColorBrush x:Key="Rule" Color="#2A2548"/>
    <SolidColorBrush x:Key="RuleStrong" Color="#4D4680"/>
    <SolidColorBrush x:Key="Accent" Color="#9DA8FF"/>
    <SolidColorBrush x:Key="AccentText" Color="#B8C0FF"/>
    <SolidColorBrush x:Key="You" Color="#FFD84D"/>
    <SolidColorBrush x:Key="OnInk" Color="#0E0C1A"/>
    <SolidColorBrush x:Key="Ok" Color="#6FD98A"/>
    <SolidColorBrush x:Key="Warn" Color="#F2C14E"/>
    <SolidColorBrush x:Key="Err" Color="#FF8A8A"/>
    <SolidColorBrush x:Key="Hover" Color="#221D3E"/>
    <SolidColorBrush x:Key="Pressed" Color="#2C264D"/>
    <!-- Depth: light comes from above. Glass tints the acrylic backdrop; Edge lights the top of a raised surface; Sheen lifts a filled button. -->
    <SolidColorBrush x:Key="BgGlass" Color="#D80E0C1A"/>
    <Color x:Key="ShadowColor">#000000</Color>
    <LinearGradientBrush x:Key="Edge" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#4D4680"/>
        <GradientStop Offset="1" Color="#2A2548"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Sheen" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#1FFFFFFF"/>
        <GradientStop Offset="0.55" Color="#00FFFFFF"/>
    </LinearGradientBrush>
</ResourceDictionary>
