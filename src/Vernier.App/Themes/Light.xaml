<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- Paper: warm-neutral daylight for bright rooms and printed-page work. Blue-family accent is the tutor, yellow is you. Contrast checked (text pairs >= 4.5:1). -->
    <sys:Boolean x:Key="IsDark">False</sys:Boolean>
    <SolidColorBrush x:Key="Bg" Color="#F3F5F6"/>
    <SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceAlt" Color="#E6EAEC"/>
    <SolidColorBrush x:Key="Ink" Color="#0F1C28"/>
    <SolidColorBrush x:Key="InkSoft" Color="#3B4A57"/>
    <SolidColorBrush x:Key="InkFaint" Color="#5A6975"/>
    <SolidColorBrush x:Key="Rule" Color="#D3D9DD"/>
    <SolidColorBrush x:Key="RuleStrong" Color="#8F9BA5"/>
    <SolidColorBrush x:Key="Accent" Color="#1479C4"/>
    <SolidColorBrush x:Key="AccentText" Color="#0F5E9A"/>
    <SolidColorBrush x:Key="You" Color="#E6B800"/>
    <SolidColorBrush x:Key="OnInk" Color="#F3F5F6"/>
    <SolidColorBrush x:Key="Ok" Color="#1E6B3A"/>
    <SolidColorBrush x:Key="Warn" Color="#7A5C00"/>
    <SolidColorBrush x:Key="Err" Color="#B42323"/>
    <SolidColorBrush x:Key="Hover" Color="#E3E8EB"/>
    <SolidColorBrush x:Key="Pressed" Color="#D3D9DD"/>
    <!-- Depth: light comes from above. Glass tints the acrylic backdrop; Edge lights the top of a raised surface; Sheen lifts a filled button. -->
    <SolidColorBrush x:Key="BgGlass" Color="#E0F3F5F6"/>
    <Color x:Key="ShadowColor">#1B2A38</Color>
    <LinearGradientBrush x:Key="Edge" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#D3D9DD"/>
        <GradientStop Offset="1" Color="#8F9BA5"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Sheen" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#59FFFFFF"/>
        <GradientStop Offset="0.55" Color="#00FFFFFF"/>
    </LinearGradientBrush>
</ResourceDictionary>
