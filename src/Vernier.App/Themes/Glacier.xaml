<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- Glacier: cold daylight, blue-grey paper with a cobalt tutor. Blue-family accent is the tutor, yellow is you. Contrast checked (text pairs >= 4.5:1). -->
    <sys:Boolean x:Key="IsDark">False</sys:Boolean>
    <SolidColorBrush x:Key="Bg" Color="#EEF3F7"/>
    <SolidColorBrush x:Key="Surface" Color="#F8FBFD"/>
    <SolidColorBrush x:Key="SurfaceAlt" Color="#E1E9EF"/>
    <SolidColorBrush x:Key="Ink" Color="#0F1D29"/>
    <SolidColorBrush x:Key="InkSoft" Color="#3C5466"/>
    <SolidColorBrush x:Key="InkFaint" Color="#536879"/>
    <SolidColorBrush x:Key="Rule" Color="#CBD7E0"/>
    <SolidColorBrush x:Key="RuleStrong" Color="#9DB2C2"/>
    <SolidColorBrush x:Key="Accent" Color="#1769C9"/>
    <SolidColorBrush x:Key="AccentText" Color="#145CB0"/>
    <SolidColorBrush x:Key="You" Color="#E6B800"/>
    <SolidColorBrush x:Key="OnInk" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Ok" Color="#1E6B3A"/>
    <SolidColorBrush x:Key="Warn" Color="#7A5C00"/>
    <SolidColorBrush x:Key="Err" Color="#B42323"/>
    <SolidColorBrush x:Key="Hover" Color="#E2EAF0"/>
    <SolidColorBrush x:Key="Pressed" Color="#D2DEE7"/>
    <!-- Depth: light comes from above. Glass tints the acrylic backdrop; Edge lights the top of a raised surface; Sheen lifts a filled button. -->
    <SolidColorBrush x:Key="BgGlass" Color="#E0EEF3F7"/>
    <Color x:Key="ShadowColor">#1B2A38</Color>
    <LinearGradientBrush x:Key="Edge" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#CBD7E0"/>
        <GradientStop Offset="1" Color="#9DB2C2"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Sheen" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#59FFFFFF"/>
        <GradientStop Offset="0.55" Color="#00FFFFFF"/>
    </LinearGradientBrush>
</ResourceDictionary>
